# LLM API Configuration (Optional - Mock provider fallback operates deterministically if unprovided)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=mock  # Options: mock, anthropic, openai

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Storage Paths
DATABASE_URL=sqlite:///./ehr_intelligence.db
CHROMA_PERSIST_DIR=./chroma_data
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
