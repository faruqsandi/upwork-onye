# LLM Provider Configuration
LLM_PROVIDER=local  # Options: local, mock, anthropic, openai
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL=llama-3.2-1b-instruct
LOCAL_LLM_TIMEOUT=30.0

# Cloud API Keys (Optional - Used when LLM_PROVIDER is anthropic or openai)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Storage Paths
DATABASE_URL=sqlite:///./ehr_intelligence.db
CHROMA_PERSIST_DIR=./chroma_data
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

